{
  "workbench.colorTheme": "Tokyo Night",
  "window.commandCenter": false,
  "workbench.iconTheme": "vscode-icons",
  "workbench.startupEditor": "none",
  "explorer.confirmDelete": false,
  "redhat.telemetry.enabled": false,
  "workbench.settings.applyToAllProfiles": [
  
  ],
  "mypy-type-checker.args": [
    "--allow-redefinition",
    "--check-untyped-defs",
    "--ignore-missing-imports",
    "--no-strict-optional",
    "--no-warn-no-return",
    "--warn-return-any",
    "--warn-redundant-casts",
    "ignore-without-code"
  ],
  "mypy-type-checker.importStrategy": "fromEnvironment",
  "[python]": {
    "editor.formatOnSaveMode": "file",
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "eeyore.yapf",
    "editor.formatOnType": false
  },
  "yapf.cellMagics": [
    "matplotlib inline"
  ],
  "isort.args": [
    "--profile",
    "black"
  ],
  "flake8.args": [
    "--max-line-length=120",
    "--enable=W0614",
    "--ignore=W291, W292, W293"
  ],
  "editor.acceptSuggestionOnEnter": "off",
  "editor.fontFamily": "HackGen, HackGen35, HackGen Console, HackGen35 Console",
  "editor.fontLigatures": false,
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.formatOnType": true,
  "editor.insertSpaces": true,
  "editor.suggestSelection": "first",
  "editor.tabSize": 2,
  "editor.trimAutoWhitespace": false,
  "editor.wordWrap": "wordWrapColumn",
  "editor.wordWrapColumn": 100,
  "editor.wordBasedSuggestions": "off",
  "chat.disableAIFeatures": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "cSpell.language": "en,en-GB",
  "cSpell.userWords": [
    "django",
    "Impl",
  ],
  "python.analysis.indexing": true,
  "python.analysis.autoSearchPaths": true,
  "python.analysis.autoImportCompletions": true,
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.include": [
    "piyo_app",
    "test_utils",
  ],
  "python.analysis.userFileIndexingLimit": 6000,
  "python.analysis.packageIndexDepths": [
    {
      "name": "django",
      "depth": 2
    },
    {
      "name": "rest_framework",
      "depth": 2
    },
    {
      "name": "fastapi",
      "depth": 2
    },
  ],
  "python.testing.pytestEnabled": true,
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.tabSize": 2
  },
  "[html]": {
    "editor.tabSize": 2
  },
  "emmet.includeLanguages": {
    "django-html": "html",
  },
  "editor.inlineSuggest.enabled": true,
  "git.confirmSync": false,
  "files.associations": {
    "*.html": "html"
  },
  "git.autofetch": true,
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.diagnosticSeverityOverrides": {
    "reportUnboundVariable": "information",
    "reportImplicitStringConcatenation": "warning"
  },
  "python.analysis.typeEvaluation.enableReachabilityAnalysis": true,
  "python.analysis.typeEvaluation.strictDictionaryInference": false,
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    },
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "vsicons.dontShowNewVersionMessage": true,
  "extensions.ignoreRecommendations": true,
  "lldb.suppressUpdateNotifications": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  },
  "editor.wrapOnEscapedLineFeeds": true,
  "jdk.telemetry.enabled": false,
  "debug.breakpointsView.presentation": "tree",
  "css.enabledLanguages": [
    "html"
  ],
  "css.styleSheets": [
    "assets/**/*.css"
  ],
  "npm.packageManager": "auto",
  "elixirLS.dialyzerWarnOpts": [
    "no_return"
  ]
}
